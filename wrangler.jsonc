{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clay-pagination-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  // Disabled so the Worker is only reachable on the custom domain. The in-Worker
  // Host allowlist (src/index.ts) enforces this regardless, so zone-level WAF /
  // rate-limit / Access rules cannot be bypassed via a *.workers.dev hostname.
  "workers_dev": false,
  "triggers": {
    // Daily run_logs retention (scheduled handler in src/index.ts).
    "crons": ["0 3 * * *"]
  },
  "routes": [
    {
      "pattern": "paginate.chris-apis.xyz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clay-pagination-runner-db",
      "database_id": "dd006cd1-aec6-4171-928d-66eb964c82bc",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["no-reply@chris-apis.xyz"]
    }
  ],
  // Per-caller rate limiting. The Worker feature-detects these bindings, so it
  // still runs if they are absent — but configure them in production.
  // namespace_id is an account-unique integer string; period must be 10 or 60.
  "ratelimits": [
    {
      "name": "RUN_RL",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "ADMIN_RL",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Durable, write-cheap run metrics (does not bloat D1). Create the dataset on
  // first deploy; query via the Analytics Engine SQL API.
  "analytics_engine_datasets": [
    {
      "binding": "RUN_METRICS",
      "dataset": "clay_paginate_runs"
    }
  ],
  "secrets": {
    "required": ["ADMIN_TOKEN", "RUNNER_TOKEN_ENCRYPTION_KEY"]
  }
}
